# Copy to .env and fill in. .env is gitignored, so keys never reach GitHub.
#
# AI engine for triage, runbooks and the Oracle:
#   gemini = Google Gemini Flash (free tier), needs GEMINI_API_KEY
#   claude = Anthropic Claude, needs ANTHROPIC_API_KEY
#   rules  = no AI, built-in rules only
# Not set: Gemini if its key is set, else Claude, else rules.
AI_PROVIDER=gemini

GEMINI_API_KEY=
# Optional: Gemini model to try first (default gemini-2.5-flash, then 3.5-flash, then 2.5-flash-lite)
# GEMINI_MODEL=

ANTHROPIC_API_KEY=

# Let the AI also type and assign the glitches the system opens itself (about one a minute).
# Off by default to save free-tier quota for echoes, runbooks and the Oracle.
# AI_SYSTEM_GLITCHES=on
